---
layout: null
permalink: /blog/search.json
---
[
{% assign searchable_posts = site.posts | where_exp: 'post', 'post.hidden != true' %}
{% for post in searchable_posts %}
  {
    "title": {{ post.title | replace: '-', ' ' | jsonify }},
    "url": {{ post.url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "displayDate": {{ post.date | date: '%b %d, %Y' | jsonify }},
    "image": {{ post.image | default: '' | jsonify }},
    "imageAlt": {{ post.image_alt | default: post.title | jsonify }},
    "description": {{ post.desc | default: post.excerpt | strip_html | normalize_whitespace | truncate: 360 | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
